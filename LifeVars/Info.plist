	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.serhansari.LifeVars</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lifevars</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
